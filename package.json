{
  "name": "restoradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "package:ec2": "node scripts/package-ec2.mjs",
    "dev": "concurrently -k -n edge,web 'npm run dev -w @restoradar/edge-api' 'npm run dev -w @restoradar/web'",
    "build": "npm run typecheck && npm run build -w @restoradar/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "setup:owner": "node --env-file-if-exists=.env --import tsx apps/edge-api/src/setup-owner.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/edge-api/src/main.ts",
    "test:e2e": "npm run build -w @restoradar/web && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build -w @restoradar/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
