# Local development only. The Compose database binds to loopback.
DATABASE_URL=postgres://restoradar:local-development-only@127.0.0.1:5432/restoradar
HOST=127.0.0.1
PORT=3001
# Never enable the event simulator on a real restaurant deployment.
ENABLE_SIMULATOR=false
# Set true behind an HTTPS reverse proxy before exposing the app.
COOKIE_SECURE=false
