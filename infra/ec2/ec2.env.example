# A hostname you control, with DNS pointing to this EC2 instance.
APP_DOMAIN=radar.example.com
PUBLIC_ORIGIN=https://radar.example.com
APP_IMAGE_TAG=local
# Enable only for explicit synthetic-event testing. No video analysis is implemented yet.
ENABLE_SIMULATOR=false
# Defaults expose only Caddy; no database or application port is published.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Relative to infra/ec2/compose.yml. This file must not be committed or included in images.
DATABASE_PASSWORD_PATH=./.secrets/database_password
